{
  "name": "zephyr",
  "private": true,
  "version": "2.7.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/z3k-md/zephyr.git"
  },
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "dotenv -e .env -- tauri build",
    "typecheck": "vue-tsc --noEmit",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "prettier --check . && vue-tsc --noEmit && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
