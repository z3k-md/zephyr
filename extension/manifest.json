{
  "manifest_version": 3,
  "name": "Zephyr",
  "version": "1.2.0",
  "key": "",
  "description": "Lets the Zephyr launcher switch to a tab you already have open instead of opening the page again, and to the tab playing music.",
  "permissions": ["tabs", "webNavigation", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  }
}
